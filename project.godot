[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.de.translation", "res://i18n/strings.en.translation")
locale/fallback="de"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="items"
3d_physics/layer_4="creatures"
3d_physics/layer_5="triggers"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
environment/ssao/quality=3
environment/ssil/quality=2
environment/screen_space_reflection/roughness_quality=2

[physics]

common/physics_interpolation=true
common/physics_jitter_fix=0.0
